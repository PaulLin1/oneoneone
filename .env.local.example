# Copy to .env.local and fill in your own values.

# Neon dashboard -> your project -> Connect.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Accounts (see "Accounts" in README.md — entirely optional for readers;
# the daily rotation, Archive, and Shuffle all work with none of this set).
#
# AUTH_SECRET should be set regardless, even if you don't want sign-in
# working yet — without it, auth() logs a MissingSecret error on every
# request (it still degrades to "signed out" rather than crashing, but the
# error is real). One-time, cheap to generate:
#   npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Sign-in itself won't work without these two — Google Cloud Console ->
# APIs & Services -> Credentials -> Create OAuth client ID -> Web
# application. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (add the production URL's
# equivalent there too once deployed).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare R2 (optional — only needed for the author-portrait pipeline's
# image storage; see OPERATIONS.md). Cloudflare dashboard -> R2 -> Manage
# API tokens -> create a token scoped to the one bucket below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The public base URL images are served from — either R2's own r2.dev
# public bucket URL or a custom domain mapped to the bucket.
R2_PUBLIC_URL=
#
# After filling in the R2_* values above, run this once:
#   npm run setup-r2-cors
# Without it, portraits render as blank space (not a broken-image icon —
# fully invisible) in Safari/WebKit-family browsers specifically: CSS
# mask-image treats a cross-origin image as a sub-resource load subject to
# CORS, unlike a plain <img> or direct navigation to the same URL, and R2
# buckets have no CORS policy by default.
