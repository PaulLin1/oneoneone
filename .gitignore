# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Author portraits live in R2 now (authors.portrait_url — see
# db/migrations/0006_portrait_urls.sql), not as git-committed static
# files. Everything under public/authors/ is local scratch space: _source/
# is the raw fetch, _staging/ is the processed-but-unreviewed output —
# neither is ever meant to be committed.
public/authors/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
